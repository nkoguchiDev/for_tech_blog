// ============================================================
// named.conf.options - グローバルオプション設定
// ============================================================

acl "trusted" {
    127.0.0.1;          // localhost
    172.20.0.0/24;      // Dockerネットワーク
    192.168.0.0/16;     // 内部ネットワーク（環境に合わせて変更）
};

options {
    directory "/var/cache/bind";

    // ----- クエリ受付設定 -----
    listen-on { any; };
    listen-on-v6 { any; };

    // ----- アクセス制御 -----
    allow-query     { trusted; };
    allow-recursion { trusted; };
    allow-transfer  { none; };      // ゾーン転送は必要な場合のみ許可

    // ----- フォワーダー設定 -----
    // 上位DNSへ転送する場合は以下を有効化
    // forwarders {
    //     8.8.8.8;       // Google DNS
    //     1.1.1.1;       // Cloudflare DNS
    // };
    // forward only;     // forwarders のみに転送（キャッシュしない場合）

    // ----- DNSSEC設定 -----
    dnssec-validation auto;

    // ----- ログ設定 -----
    querylog yes;

    // ----- パフォーマンス設定 -----
    recursive-clients 1000;
    max-cache-size 256m;

    // ----- セキュリティ設定 -----
    version "none";                  // バージョン情報を隠す
    hostname "none";
    server-id "none";
};

// ----- rndc（リモート管理）設定 -----
controls {
    inet 0.0.0.0 port 953 allow { 127.0.0.1; 172.20.0.0/24; };
};

// ----- ログ設定（標準出力へ出力）-----
logging {
    // stderr に出力 → Docker が標準出力としてキャプチャする
    channel default_log {
        stderr;
        severity dynamic;
        print-time yes;
        print-severity yes;
        print-category yes;
    };

    channel queries_log {
        stderr;
        severity info;
        print-time yes;
        print-severity yes;
        print-category yes;
    };

    channel security_log {
        stderr;
        severity dynamic;
        print-time yes;
        print-severity yes;
        print-category yes;
    };

    category default         { default_log; };
    category queries         { queries_log; };
    category security        { security_log; };
    category dnssec          { security_log; };
};
